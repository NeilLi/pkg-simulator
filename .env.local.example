# Copy to .env.local for local development.

# Frontend
VITE_DB_PROXY_URL=http://127.0.0.1:3011
SEEDCORE_API=http://127.0.0.1:8002

# DB proxy
DB_PROXY_PORT=3011
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=seedcore
POSTGRES_USER=ningli
POSTGRES_PASSWORD=

# You can use a DSN instead of the discrete POSTGRES_* values:
# PG_DSN=postgresql://ningli@127.0.0.1:5432/seedcore
